# Copy to .env for local overrides. Do not put secrets in this file.
API_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=replace-with-local-postgresql-connection-url
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional only for legacy HS256 Supabase tokens. Backend only; never commit a real value.
# SUPABASE_JWT_SECRET=replace-with-backend-only-legacy-jwt-secret
CODE_EXECUTION_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
OPENAI_API_KEY=replace-with-backend-only-api-key
AI_TIMEOUT_SECONDS=30
# Used by the candidate assistant and, when AI_PROVIDER=gemini, interview generation.
# GEMINI_API_KEY=replace-with-backend-only-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25
FOLLOW_UP_QUESTION_COUNT=3
