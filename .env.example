POSTGRES_DB=replace-with-local-database-name
POSTGRES_USER=replace-with-local-database-user
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=replace-with-local-postgresql-connection-url
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
# Supabase Auth configuration is backend-only. The URL is public; never add a
# JWT signing secret or service-role key to any VITE_ frontend variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# JSON list of Supabase Auth UUIDs approved for evaluator access. Empty by default.
EVALUATOR_USER_IDS=[]
# Only required if this Supabase project still issues legacy HS256 tokens.
# Keep the JWT secret in the ignored root .env; do not commit or share it.
# SUPABASE_JWT_SECRET=replace-with-your-backend-only-legacy-jwt-secret
CODE_EXECUTION_ENABLED=false
CODE_RUNNER_IMAGE=codeproof-runner:local
CODE_RUNNER_TIMEOUT_SECONDS=8
CODE_RUNNER_MAX_CASES=20
CODE_RUNNER_MAX_CONCURRENCY=2
# Optional backend-only AI draft generation. Keep the real key only in ignored .env.
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
OPENAI_API_KEY=replace-with-your-backend-only-api-key
AI_TIMEOUT_SECONDS=30
# Optional backend-only candidate assistant. Never use a VITE_ variable here.
# Set the actual Gemini key only in the ignored root .env or backend host settings.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=25
FOLLOW_UP_QUESTION_COUNT=3
